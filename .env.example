# Secure API deployment settings. Keep the actual .env ignored and outside source control.
PORT=3000
SESSION_TTL_DAYS=7
PUBLIC_SITE_URL=https://online254.github.io/Online-Sphere-
CORS_ORIGINS=https://online254.github.io,http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false

# Owner bootstrap uses these values only on the backend at startup.
# Use a unique random password (14+ chars, upper/lower/digit/symbol). Do not commit real values.
OWNER_EMAIL=muthinibenson7@gmail.com
OWNER_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_SECRET

# Daraja credentials must remain in backend environment. Payment routes are not enabled in secure-server until they have been migrated and verified.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=YOUR_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET
MPESA_SHORTCODE=YOUR_SHORTCODE
MPESA_PASSKEY=YOUR_PASSKEY
MPESA_CALLBACK_URL=https://YOUR-BACKEND-DOMAIN.onrender.com/api/mpesa/callback

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
DATABASE_URL=
