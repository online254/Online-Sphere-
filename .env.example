PORT=3000
SESSION_TTL_DAYS=30
PUBLIC_SITE_URL=https://your-domain.example.com

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=YOUR_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET
MPESA_SHORTCODE=YOUR_SHORTCODE
MPESA_PASSKEY=YOUR_PASSKEY
MPESA_CALLBACK_URL=https://YOUR-BACKEND-DOMAIN.onrender.com/api/mpesa/callback

# OWNER_ADMIN_ACCOUNT (production-only, never publish in frontend or repo)
OWNER_EMAIL=owner@yourdomain.com
OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Online Sphere AI (keep the real key in your deployment environment, never in frontend code)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini

# Optional PostgreSQL for production analytics / opportunities
DATABASE_URL=
