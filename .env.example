PORT=3000
SESSION_TTL_DAYS=30
PUBLIC_SITE_URL=https://your-domain.example.com

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=YOUR_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_CONSUMER_SECRET
MPESA_SHORTCODE=YOUR_SHORTCODE
MPESA_PASSKEY=YOUR_PASSKEY
MPESA_CALLBACK_URL=https://YOUR-BACKEND-DOMAIN.onrender.com/api/mpesa/callback

# Required for the owner-only admin account
OWNER_EMAIL=owner@yourdomain.com
OWNER_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# OpenAI integration for Online Sphere AI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini

# Optional PostgreSQL / Neon for large production data
DATABASE_URL=
